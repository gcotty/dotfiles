#!/usr/bin/env bash

# Use current dir as the tmux session name
SESSION=$(basename "$PWD")

SESSION=${SESSION//./_}
SESSION=${SESSION//:/_}

if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
  TERMINAL_WIDTH=$(tput cols 2>/dev/null || printf '80\n')
  TERMINAL_HEIGHT=$(tput lines 2>/dev/null || printf '24\n')

  # The status bar occupies one terminal row
  WINDOW_HEIGHT=$((TERMINAL_HEIGHT - 1))

  # Split main 70:30 with right; 80:20 with bottom
  MAIN_PANE=$(tmux new-session -d -s "$SESSION" -c "$PWD" -x "$TERMINAL_WIDTH" -y "$WINDOW_HEIGHT" -P -F '#{pane_id}')
  RIGHT_PANE=$(tmux split-window -h -p 30 -c "$PWD" -t "$MAIN_PANE" -P -F '#{pane_id}')
  BOTTOM_PANE=$(tmux split-window -v -p 20 -c "$PWD" -t "$MAIN_PANE" -P -F '#{pane_id}')

  # Start neovim in upper left
  tmux send-keys -t "$MAIN_PANE" 'nvim .' Enter
  tmux select-pane -t "$MAIN_PANE"
fi

tmux attach-session -t "=$SESSION"
